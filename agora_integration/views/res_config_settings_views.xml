<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_agora" model="ir.ui.view">
        <field name="name">res.config.settings.form.agora</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@groups='point_of_sale.group_pos_manager']" position="inside">
                <field name="pos_config_is_agora" invisible="1"/>
            </xpath>
            <xpath expr="//div[@id='pos_interface_section']/parent::div" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('pos_config_id', '=', False), ('pos_config_is_agora', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
